// Baza de date a sistemului de programări.
// SQLite — un singur fișier, ușor de rulat și de salvat pe VPS.
// Pentru trecerea la PostgreSQL: schimbă `provider` și `DATABASE_URL`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Clienți și administrator. `role` este "CLIENT" sau "ADMIN"
/// (SQLite nu acceptă enum-uri native, tipurile sunt în src/lib/types.ts).
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String
  passwordHash String
  role         String        @default("CLIENT")
  createdAt    DateTime      @default(now())
  sessions     Session[]
  appointments Appointment[]
  contracts    Contract[]
}

/// Sesiuni păstrate în baza de date, ca să poată fi revocate.
/// În cookie ajunge tokenul brut; aici se salvează doar hash-ul lui.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Serviciile care pot fi programate, cu durata lor în minute.
model Service {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  duration     Int           @default(50)
  /// Prețul în bani (28000 = 280 lei). Evită erorile de rotunjire de la zecimale.
  price        Int           @default(28000)
  description  String?
  active       Boolean       @default(true)
  position     Int           @default(0)
  appointments Appointment[]
}

/// O programare. `startsAt` / `endsAt` se păstrează în UTC;
/// conversia spre ora României se face în src/lib/tz.ts.
///
/// Programarea poate veni de la un cont (`userId`) sau de la cineva care a ales
/// să nu își facă cont — atunci datele de contact stau în câmpurile `guest*`.
/// Exact una dintre cele două variante este completată.
model Appointment {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestName  String?
  guestEmail String?
  guestPhone String?
  serviceId  String
  service    Service    @relation(fields: [serviceId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  format     String     @default("CABINET")
  status     String     @default("PENDING")
  notes      String?
  adminNote  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  payments   Payment[]
  contracts  Contract[]

  @@index([startsAt])
  @@index([userId])
  @@index([status])
  @@index([guestEmail])
}

/// Programul săptămânal recurent. weekday: 0 = duminică … 6 = sâmbătă.
model Availability {
  id        String  @id @default(cuid())
  weekday   Int
  startTime String
  endTime   String
  active    Boolean @default(true)

  @@unique([weekday, startTime, endTime])
}

/// Zile în care nu se lucrează (concediu, sărbători).
/// `date` este "YYYY-MM-DD" în ora României — fără ambiguități de fus orar.
model BlockedDate {
  id     String  @id @default(cuid())
  date   String  @unique
  reason String?
}

/// Răspunsurile la chestionarul de brief, salvate pe măsură ce sunt completate.
/// Fiecare întrebare are cheia ei, deci un răspuns nou îl înlocuiește pe cel
/// vechi fără să pierdem restul.
model BriefAnswer {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Fișierele încărcate în chestionar (de exemplu modelul de contract).
/// Se salvează în afara folderului public — se descarcă doar din panou.
model BriefFile {
  id        String   @id @default(cuid())
  key       String
  fileName  String
  storedAs  String   @unique
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@index([key])
}

/// O încercare de plată. Deocamdată doar Stripe, dar `provider` lasă loc și
/// altora fără schimbări de structură.
model Payment {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  provider      String      @default("STRIPE")
  /// Identificatorul de la furnizor (la Stripe, sesiunea de checkout).
  externalId    String?     @unique
  /// În bani, ca și prețul serviciului.
  amount        Int
  currency      String      @default("RON")
  /// PENDING | PAID | FAILED | REFUNDED
  status        String      @default("PENDING")
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  invoice       Invoice?

  @@index([appointmentId])
  @@index([status])
}

/// Factura emisă pentru o plată.
///
/// `provider` spune cine a emis-o. Cât timp nu e ales niciun program de
/// facturare, se salvează aici datele necesare, cu status DRAFT — nu se pierde
/// nimic, iar la conectare pot fi emise retroactiv.
model Invoice {
  id        String    @id @default(cuid())
  paymentId String?   @unique
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  /// NONE | SMARTBILL | FGO | SAGA
  provider  String    @default("NONE")
  series    String?
  number    String?
  /// Linkul către factura de la furnizor, dacă există.
  url       String?
  /// DRAFT | ISSUED | FAILED
  status    String    @default("DRAFT")
  issuedAt  DateTime?
  /// Mesajul de eroare, dacă emiterea a eșuat.
  error     String?
  /// Datele trimise, păstrate pentru depanare și pentru reemitere.
  payload   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
}

/**
 * ============================================================================
 * Contracte
 * Psihologul trimite un contract dintr-un șablon PDF completabil. Clientul
 * primește un link cu token, completează datele și semnează cu degetul sau cu
 * mouse-ul. Sistemul completează șablonul, lipește semnătura peste linia
 * punctată, aplatizează PDF-ul și îl arhivează.
 * ⚠️ Datele completate conțin CNP și istoric medical — date sensibile în
 * sensul GDPR. De aceea PDF-ul generat NU ajunge niciodată în `public/`, ci
 * în `uploads/contracte/`, și se descarcă doar cu token sau ca administrator.
 * ==========================================================================
 */
model Contract {
  id     String @id @default(cuid())
  /**
   * Din link. 32 de octeți aleatori — nu poate fi ghicit sau enumerat.
   */
  token  String @unique
  /**
   * ADULT | MINOR — decide șablonul și câte semnături sunt cerute.
   */
  type   String
  /**
   * Numărul de pe contract, crescător pe cabinet.
   */
  number Int
  /**
   * SENT | SIGNED | CANCELLED
   */
  status String @default("SENT")

  /**
   * Cui i-a fost trimis linkul.
   */
  sentToName  String
  sentToEmail String
  /**
   * Prețul scris în contract, în bani (28000 = 280 lei).
   */
  price       Int

  /**
   * Legături opționale, ca să apară contractul lângă client și programare.
   */
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  /**
   * Ce a completat clientul, ca JSON — șablonul se poate schimba fără
   * migrare. Conține date sensibile.
   */
  data       String?
  /**
   * Semnăturile, PNG în base64. La minor sunt două: mama și tata.
   */
  signature1 String?
  signature2 String?

  /**
   * Fișierul final, relativ la `uploads/`.
   */
  pdfPath String?
  /**
   * SHA-256 al PDF-ului, ca să se poată dovedi că nu a fost modificat.
   */
  pdfHash String?

  /**
   * Urmă pentru probă: de unde și cu ce a semnat clientul.
   */
  signedIp    String?
  signedAgent String?

  sentAt    DateTime  @default(now())
  signedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([sentToEmail])
  @@index([userId])
}
