# Copiază acest fișier în `.env.local` (dezvoltare) sau `.env.production` (VPS)
# și completează valorile reale. NU urca fișierele .env în git.

# Adresa publică a site-ului
NEXT_PUBLIC_SITE_URL=https://psihologlilianajgheban.ro

# Adresa pe care ajung mesajele din formulare
CONTACT_EMAIL=contact@psihologlilianajgheban.ro

# --- Trimitere email -------------------------------------------------------
# Varianta 1: Resend (cel mai simplu) — https://resend.com
RESEND_API_KEY=

# Varianta 2: SMTP clasic (ex. de la găzduirea de email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Bază de date (pentru sistemul de programări, etapa următoare) ----------
# DATABASE_URL=postgresql://utilizator:parola@localhost:5432/psiholog_lj
