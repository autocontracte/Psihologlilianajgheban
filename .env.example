# Copiază acest fișier în `.env.local` (dezvoltare) sau `.env.production` (VPS)
# și completează valorile reale. NU urca fișierele .env în git.

# Adresa publică a site-ului
NEXT_PUBLIC_SITE_URL=https://psihologlilianajgheban.ro

# Adresa pe care ajung mesajele din formulare
CONTACT_EMAIL=contact@psihologlilianajgheban.ro

# --- Trimitere email (SMTP, Zoho) ------------------------------------------
# Cât timp lipsesc, emailurile nu se trimit (apar doar în log).
# Datele se iau din Zoho, după ce domeniul e verificat. Portul 465 = TLS,
# 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Expeditorul — trebuie să fie pe domeniul verificat în Zoho
MAIL_FROM="Psiholog Liliana Jgheban <no-reply@psihologlilianajgheban.ro>"

# --- Bază de date (pentru sistemul de programări, etapa următoare) ----------
# DATABASE_URL=postgresql://utilizator:parola@localhost:5432/psiholog_lj

# --- Plăți online (Stripe) ---------------------------------------------------
# Cât timp lipsesc, butonul de plată nu apare deloc pe site.
# Cheile se iau din dashboard.stripe.com → Developers → API keys.
# NU le pune niciodată în git.
STRIPE_SECRET_KEY=
# Se obține când creezi webhook-ul către /api/plati/webhook
STRIPE_WEBHOOK_SECRET=

# --- Facturare ---------------------------------------------------------------
# Lasă gol până alegeți programul. Facturile se salvează oricum și pot fi
# emise retroactiv. Valori acceptate: SMARTBILL, FGO
INVOICE_PROVIDER=
# ⚠️ Confirmă cota cu contabilul înainte de prima factură reală.
INVOICE_VAT_RATE=0

# SmartBill
SMARTBILL_EMAIL=
SMARTBILL_TOKEN=
SMARTBILL_CIF=
SMARTBILL_SERIES=

# FGO
FGO_API_KEY=
FGO_CUI=
FGO_SERIES=

# --- Interpretare AI (ghidul despre divorț) -----------------------------------
# Cheia de la platform.openai.com. Fara ea, interpretarea nu se genereaza.
OPENAI_API_KEY=
# Optional: modelul folosit (implicit gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
